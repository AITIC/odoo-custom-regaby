<odoo>

       <record id="view_invoice_form_inherit" model="ir.ui.view">
        <field name="name">account.document_invoice.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <field name="use_manual_number" invisible="1" position="replace">
                <field name="use_manual_number" invisible="1"/>
            </field>
            <field name="invoice_date" position="before">
                <field name="manual_number"
                    invisible="not use_manual_number"
                    required="use_manual_number"
                    readonly="state != 'draft'"/>
            </field>
        </field>
    </record>

</odoo>
