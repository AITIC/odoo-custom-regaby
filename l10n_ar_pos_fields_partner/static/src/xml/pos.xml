<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <!-- Extend PartnerLine to show AFIP responsibility, identification type and VAT -->
    <t t-name="point_of_sale.PartnerLine" t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <!-- Add AFIP/doc type/VAT after address cell in desktop table row -->
        <xpath expr="//tr/td[2]" position="after">
            <td class="text-break w-25" t-if="!ui.isSmall">
                <t t-out="props.partner.l10n_ar_afip_responsibility_type_id?.[1] or ''" />
            </td>
            <td class="text-break w-25" t-if="!ui.isSmall">
                <t t-out="props.partner.l10n_latam_identification_type_id?.[1] or ''" />
            </td>
            <td class="text-break w-25" t-if="!ui.isSmall">
                <t t-out="props.partner.vat or ''" />
            </td>
        </xpath>
    </t>
</templates>
